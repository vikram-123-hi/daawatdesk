rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'swainvikramaditya99@gmail.com';
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /licenses/{paymentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.email);
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /users/{userId}/kots/{kotId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /users/{userId}/inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/stockMovements/{movementId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/transactions/{txnId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/customers/{customerId} {
      allow list: if true;
      allow get: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /users/{userId}/suppliers/{supplierId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/expenses/{expenseId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/reservations/{reservationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /users/{userId}/notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
