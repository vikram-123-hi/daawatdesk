# Client-side (VITE_ = exposed to browser; never put secrets here)
VITE_GROQ_KEY=your_groq_api_key
VITE_IMGBB_KEY=your_imgbb_api_key
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Server-side (Cloudflare Pages Functions / dashboard environment; NEVER commit real values)
ALLOWED_ORIGIN=your_site_origin_or_*  # optional CORS origin (defaults to *)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=DaawatDesk <noreply@your-domain.com>
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}  # or FIREBASE_SERVICE_ACCOUNT_B64=<base64>
